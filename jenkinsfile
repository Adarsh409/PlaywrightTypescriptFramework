pipeline {
  agent any

  options {
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  triggers {
    cron('H 2 * * *')
  }

  stages {
    stage('Test') {
      environment {
        CI = 'true'
        LOGIN_EMAIL          = credentials('login-email')
        LOGIN_PASSWORD       = credentials('login-password')
        ADMIN_LOGIN_EMAIL    = credentials('admin-login-email')
        ADMIN_LOGIN_PASSWORD = credentials('admin-login-password')
      }
      steps {
        bat '''
          docker run --rm --ipc=host ^
            -v "%WORKSPACE%":/work -w /work ^
            -e CI ^
            -e LOGIN_EMAIL ^
            -e LOGIN_PASSWORD ^
            -e ADMIN_LOGIN_EMAIL ^
            -e ADMIN_LOGIN_PASSWORD ^
            mcr.microsoft.com/playwright:v1.63.0-noble ^
            /bin/bash -c "rm -rf allure-results test-results && npm ci && npx playwright test"
        '''
      }
    }
  }

  post {
    always {
      allure commandline: 'allure', includeProperties: false, results: [[path: 'allure-results']]
      archiveArtifacts artifacts: 'test-results/**', allowEmptyArchive: true
    }
  }
}